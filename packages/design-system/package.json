{
  "name": "@mental-health/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
